# ===================== 传输方式 =====================
# cli = 用本地已登录的 CLI（不消耗 API Key）；api = 用下面的 API Key
CLAUDE_TRANSPORT=cli      # Claude Code CLI
DEEPSEEK_TRANSPORT=cli    # dsh
GEMINI_TRANSPORT=cli      # agy
SONNET_TRANSPORT=cli      # agy
OPUS_TRANSPORT=cli        # agy
GPT_TRANSPORT=cli         # agy

# ===================== agy 模型版本 =====================
GEMINI_MODEL=gemini-3.8-flash-high
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-6-thinking
GPT_MODEL=gpt-oss-120b-medium

# ===================== 角色分配（可选）=====================
# 默认：scout/implementer/tester/host=deepseek
#       architect/judge=claude、skeptic=gemini
# ROLE_ARCHITECT=claude
# ROLE_IMPLEMENTER=deepseek
# ROLE_SKEPTIC=gemini
# ROLE_TESTER=deepseek
# ROLE_JUDGE=claude
# ROLE_HOST=deepseek
# ROLE_SCOUT=deepseek

# ===================== API Key（仅 api 传输需要）=====================
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ===================== 可选：覆盖模型名 =====================
# CLAUDE_MODEL=claude-sonnet-4-5
# DEEPSEEK_MODEL=deepseek-chat

# ===================== 成本控制 =====================
# 材料包字符预算。材料包会被塞进**每一次**模型调用，是最大的成本来源。
# 默认 60000；调小到 25000~30000 通常能省三成以上。
# AIDISCUSS_CONTEXT_BUDGET=30000

# 交叉质询轮次与主持人可见的历史字符预算，默认 40000；0 = 不限制。
# judge 永远看完整历史（它的产物是最终方案），不受此项影响。
# AIDISCUSS_HISTORY_BUDGET=20000

# 角色申请补充文件的字符预算，默认 20000。
# AIDISCUSS_EXTRA_CONTEXT_BUDGET=10000

# 每个文件最多读取的行数，默认 160。大文件只会读到前 N 行。
# AIDISCUSS_SNIPPET_LINES=120

# 单个文件字节上界，超过直接跳过，默认 400000。
# AIDISCUSS_MAX_FILE_BYTES=200000
